{
  "name": "mia-ruso",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "server": "node server/index.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.mjs",
    "invite": "node server/invite.mjs",
    "test": "node --test tests/*.test.mjs",
    "build:pages": "tsc --noEmit && vite build --mode pages --outDir docs --emptyOutDir false"
  },
  "dependencies": {
    "reveal.js": "^5.2.1",
    "ts-fsrs": "^5.2.3"
  },
  "devDependencies": {
    "@types/reveal.js": "^5.2.2",
    "typescript": "^5.9.3",
    "vite": "^7.1.7",
    "@playwright/test": "^1.55.1"
  }
}
